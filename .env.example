# Leave empty for local development. GitHub Pages uses /KodBuster_ru_v2.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_SITE_URL=https://kodbuster.github.io/KodBuster_ru_v2/

# Контакты на сайте. Пустое значение — канал не показывается.
# Телефон в том виде, как показывать: +7 (9XX) XXX-XX-XX
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/kodbuster
NEXT_PUBLIC_MAX_URL=

# Адрес приёмника заявок (api/lead.php на PHP-хостинге).
# Локально: node scripts/lead-dev-server.mjs → http://localhost:8787/api/lead
NEXT_PUBLIC_LEAD_ENDPOINT=

# Яндекс Метрика (цели form_start, lead_submit).
# Счётчик подключается только после согласия на cookie. Пусто — не подключается.
NEXT_PUBLIC_YM_ID=

# Реквизиты оператора персональных данных для политики (152-ФЗ).
# Пустые поля на странице политики помечаются как ещё не опубликованные.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_INN=
NEXT_PUBLIC_OPERATOR_OGRN=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_EMAIL=
